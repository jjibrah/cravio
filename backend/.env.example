PORT=3002
FRONTEND_URL=http://localhost:5173

# Supabase project URL and browser-safe anon key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only service key and database connection string for setup and seeding.
# Never copy these into frontend/.env.
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Only this email is assigned admin when created in Supabase Auth.
SUPER_ADMIN_EMAIL=ibrabdi109@gmail.com

# Optional: AI recipe suggestions in Inventory (OpenRouter). Leave empty to switch them off;
# managers can always enter recipes by hand. Only dish names/descriptions and stock item names are sent.
# OPENROUTER_API_KEY=
# Any OpenRouter model id. Default: openai/gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini
