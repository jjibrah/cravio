# Copy this file to frontend/.env and fill in your Supabase project details.
VITE_SUPABASE_URL=
# Accepts a publishable key or the legacy anon key from backend/.env.
VITE_SUPABASE_PUBLISHABLE_KEY=

# VITE_ values are exposed to the browser. Never put a secret or service_role key here.

# Optional for an API hosted on a separate origin; empty uses /api on this origin.
VITE_API_URL=

# Temporary waiter header name until restaurant data is connected.
VITE_RESTAURANT_NAME=
